/**
 * SNN + NSGA-II/III + JADE/SHADE-like DE + OMOPSO turbulence hybrid.
 *
 * Main idea:
 * - SNN is used as a fast structured generator
 * - NSGA-II style elitist environmental selection drives convergence
 * - NSGA-III style reference-vector niching is used for many-objective last-front filling
 * - JADE/SHADE style current-to-pbest DE improves search power at low cost
 * - OMOPSO-style turbulence helps escape stagnation
 * - An external archive stores elite nondominated leaders, but it is not the only engine
 *
 * Notes:
 * - competitive runtime comes from small offspring size, cached archive stats, and simple operators
 * - for two objectives, crowding is used in the final split front
 * - for three or more objectives, reference-vector PBI niching is used
 */
public class SNNHybridReferenceEnvSelectionT extends AbstractAlgorithm implements Configurable {

    private static final int OP_SNN = 0;
    private static final int OP_DE = 1;
    private static final int OP_SBX = 2;
    private static final int OP_TURB = 3;
    private static final int NUM_OPERATORS = 4;

    private final Initialization initialization;
    private final NondominatedPopulation archive;

    // Core sizes
    private int populationSize;
    private int offspringSize;
    private int archiveSize;
    private int neuronsPerVariable;
    private int referenceVectorCount;
    private int gridBins;

    // SNN dynamics
    private double learningRate;
