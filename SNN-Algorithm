    private double localSearchSigma;
    private double minLocalSearchSigma;
    private double maxLocalSearchSigma;
    private double leaderAttraction;
    private double archivePullStrength;
    private double dormantBoost;
    private double lateralInhibition;

    // Variation parameters
    private double turbulenceStrength;
    private double mutationRate;
    private double polynomialEta;
    private double sbxEta;
    private double pbiTheta;
    private double pbestRate;
    private int stagnationThreshold;
    private int shadeMemorySize;

    // State
    private List<Solution> population;
    private double[][] membranePotentials;
    private double[][] firingUsage;
    private double[][] referenceVectors;
    private boolean modelInitialized;
    private int iterationCounter;
    private int iterationsWithoutImprovement;

    // SHADE-style memories for DE
    private double[] memoryF;
